{
  "name": "safemerge",
  "version": "0.4.0",
  "description": "Diz se a sua branch pode ser mergeada antes do merge: conflitos (inclusive com outros PRs e semânticos), segurança e riscos do que a branch introduz.",
  "type": "module",
  "bin": {
    "safemerge": "dist/cli.js"
  },
  "files": [
    "dist",
    "action.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "dev": "node --import tsx src/cli.ts",
    "test:complex": "node --import tsx --test --test-reporter=spec test/complex/complex.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "git",
    "merge",
    "conflict",
    "conflito",
    "pull-request",
    "security",
    "sarif",
    "lgpd",
    "code-review",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaocarpim/safe-merge.git"
  },
  "bugs": {
    "url": "https://github.com/joaocarpim/safe-merge/issues"
  },
  "homepage": "https://github.com/joaocarpim/safe-merge#readme",
  "author": "Joao Carpim"
}
